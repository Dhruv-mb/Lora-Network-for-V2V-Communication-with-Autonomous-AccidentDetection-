
/*
 * Project: LoRa Network for V2V Communication with Autonomous Accident Detection and Predictive Location-Based Hazard Alerts
 * Module: Primary Vehicle Node (Transmitter & GSM Failover)
 * Hardware: TTGO T-Call V1.4 (ESP32 + SIM800L), SX1278 LoRa, NEO-6M GPS, SSD1306 OLED, YL-99 Impact Sensor
 * Author: Dhruv S. Karekar & Team (KIT's College of Engineering, Kolhapur)
 */

#define TINY_GSM_MODEM_SIM800
#define TINY_GSM_RX_BUFFER 1024

#include <Wire.h>
#include <SPI.h>
#include <LoRa.h>
#include <TinyGPS++.h>
#include <TinyGsmClient.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// ================= USER CONFIGURATION =================
const String NODE_ID = "VH-01";                  // Unique Vehicle Identifier
const String EMERGENCY_PHONE = "+91XXXXXXXXXX";  // Replace with emergency contact number
const long LORA_FREQUENCY = 433E6;               // 433 MHz ISM Band
const byte LORA_SYNC_WORD = 0xF3;                // Private network sync word

// ================= PIN DEFINITIONS =================
// OLED Display (I2C)
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1
#define OLED_SDA 21
#define OLED_SCL 22

// SX1278 LoRa Module (Hardware SPI)
#define LORA_SCK 18
#define LORA_MISO 19
#define LORA_MOSI 2
#define LORA_SS 13
#define LORA_RST 12
#define LORA_DIO0 14

// SIM800L GSM Modem (TTGO T-Call V1.4 UART1)
#define MODEM_RST 5
#define MODEM_PWKEY 4
#define MODEM_POWER_ON 23
#define MODEM_TX 27
#define MODEM_RX 26

// NEO-6M GPS Module (UART2)
#define GPS_RX_PIN 25
#define GPS_TX_PIN 15

// Sensors & Tactile UI Buttons
#define IMPACT_SENSOR_PIN 0
#define BTN_SCROLL 33
#define BTN_SELECT 32
#define BTN_CANCEL 35  // Note: Input-only pin (requires external 10k pull-up on PCB)

// ================= OBJECT INITIALIZATION =================
HardwareSerial SerialAT(1);
HardwareSerial gpsSerial(2);
TinyGsm modem(SerialAT);
TinyGPSPlus gps;
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// ================= STATE MACHINE & TIMERS =================
int impactState = 0;  // 0: Standby, 1: 10s Abort Window, 2: Active Emergency Broadcast
bool inMenu = false;
int selectedItem = 0;
const int totalMenuItems = 3;
const char* menuItems[totalMenuItems] = {"Send SMS Alert", "SOS Call + SMS", "Broadcast LoRa"};

unsigned long lastDebounceTime = 0;
const unsigned long debounceDelay = 200;
unsigned long lastDisplayUpdate = 0;

// ================= FUNCTION PROTOTYPES =================
void updateLiveDisplay();
void renderMenu();
bool runImpactCancelWindow();
void triggerAutomaticSOS();
void executeManualAction(int index);
void broadcastLoRaPacket(String alertType, String latStr, String lngStr);

void setup() {
  Serial.begin(115200);

  // Configure GPIO Inputs
  pinMode(IMPACT_SENSOR_PIN, INPUT_PULLUP);
  pinMode(BTN_SCROLL, INPUT_PULLUP);
  pinMode(BTN_SELECT, INPUT_PULLUP);
  pinMode(BTN_CANCEL, INPUT);  // External 10k pull-up used on GPIO 35

  // Initialize I2C & OLED
  Wire.begin(OLED_SDA, OLED_SCL);
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("SSD1306 allocation failed"));
    for (;;);
  }
  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);
  display.setTextSize(1);
  display.setCursor(0, 10);
  display.println(F("OmniNode V2V Booting"));
  display.println(F("Initializing Buses..."));
  display.display();

  // Initialize SPI & SX1278 LoRa
  SPI.begin(LORA_SCK, LORA_MISO, LORA_MOSI, LORA_SS);
  LoRa.setPins(LORA_SS, LORA_RST, LORA_DIO0);
  if (!LoRa.begin(LORA_FREQUENCY)) {
    Serial.println(F("LoRa init failed!"));
    display.println(F("LoRa Error!"));
    display.display();
    while (1);
  }
  LoRa.setSyncWord(LORA_SYNC_WORD);
  Serial.println(F("LoRa Initialized at 433 MHz"));

  // Initialize GPS UART2
  gpsSerial.begin(9600, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);

  // Power-On Sequence for SIM800L GSM
  pinMode(MODEM_PWKEY, OUTPUT);
  pinMode(MODEM_RST, OUTPUT);
  pinMode(MODEM_POWER_ON, OUTPUT);
  digitalWrite(MODEM_PWKEY, LOW);
  digitalWrite(MODEM_RST, HIGH);
  digitalWrite(MODEM_POWER_ON, HIGH);

  SerialAT.begin(115200, SERIAL_8N1, MODEM_RX, MODEM_TX);
  delay(3000);

  display.println(F("Modem Network Sync..."));
  display.display();
  modem.restart();

  if (!modem.waitForNetwork(30000L)) {
    Serial.println(F("GSM Network Timeout - Operating in LoRa-Only Mode"));
  } else {
    Serial.println(F("GSM Connected. Signal RSSI: ") + String(modem.getSignalQuality()));
  }

  delay(1000);
  display.clearDisplay();
}

void loop() {
  // 1. Continuously feed GPS serial stream (Non-blocking)
  while (gpsSerial.available() > 0) {
    gps.encode(gpsSerial.read());
  }

  // 2. Check Hardware Crash Trigger (Active LOW)
  if (digitalRead(IMPACT_SENSOR_PIN) == LOW && impactState == 0) {
    impactState = 1;
    if (runImpactCancelWindow()) {
      impactState = 2;
      triggerAutomaticSOS();
    } else {
      impactState = 0;
    }
  }

  // 3. Handle Tactile UI Navigation in Standby Mode
  if (impactState == 0 && (millis() - lastDebounceTime > debounceDelay)) {
    if (digitalRead(BTN_SELECT) == LOW) {
      lastDebounceTime = millis();
      if (!inMenu) {
        inMenu = true;
        selectedItem = 0;
      } else {
        executeManualAction(selectedItem);
        inMenu = false;
      }
    } else if (digitalRead(BTN_SCROLL) == LOW && inMenu) {
      lastDebounceTime = millis();
      selectedItem = (selectedItem + 1) % totalMenuItems;
    } else if (digitalRead(BTN_CANCEL) == LOW && inMenu) {
      lastDebounceTime = millis();
      inMenu = false;
    }
  }

  // 4. Listen for Incoming V2V Hazard Packets
  int packetSize = LoRa.parsePacket();
  if (packetSize) {
    String incoming = "";
    while (LoRa.available()) {
      incoming += (char)LoRa.read();
    }
    Serial.println("V2V Alert Received: " + incoming);
    display.clearDisplay();
    display.setTextSize(1);
    display.setCursor(0, 0);
    display.println(F("!! HAZARD AHEAD !!"));
    display.println(F("---------------------"));
    display.println(incoming);
    display.display();
    delay(4000);  // Display alert briefly
  }

  // 5. Refresh OLED Dashboard
  if (impactState == 0 && (millis() - lastDisplayUpdate > 500)) {
    lastDisplayUpdate = millis();
    if (inMenu) {
      renderMenu();
    } else {
      updateLiveDisplay();
    }
  }
}

void updateLiveDisplay() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.print(F("NODE: "));
  display.print(NODE_ID);
  display.print(F(" | SAT: "));
  display.println(gps.satellites.isValid() ? gps.satellites.value() : 0);
  display.println(F("---------------------"));

  display.print(F("LAT: "));
  display.println(gps.location.isValid() ? String(gps.location.lat(), 6) : "Searching...");
  display.print(F("LNG: "));
  display.println(gps.location.isValid() ? String(gps.location.lng(), 6) : "Searching...");

  display.setCursor(0, 54);
  display.println(F("[SELECT] Open Menu"));
  display.display();
}

void renderMenu() {
  display.clearDisplay();
  display.setTextSize(1);
  display.setCursor(0, 0);
  display.println(F("=== MANUAL DISPATCH ==="));
  for (int i = 0; i < totalMenuItems; i++) {
    display.setCursor(0, 16 + (i * 12));
    display.print(i == selectedItem ? F("> ") : F("  "));
    display.println(menuItems[i]);
  }
  display.display();
}

bool runImpactCancelWindow() {
  for (int sec = 10; sec >= 0; sec--) {
    display.clearDisplay();
    display.setTextSize(1);
    display.setCursor(0, 0);
    display.println(F("!! IMPACT DETECTED !!"));
    display.setTextSize(2);
    display.setCursor(20, 22);
    display.print(F("SOS: "));
    display.print(sec);
    display.println(F("s"));
    display.setTextSize(1);
    display.setCursor(0, 52);
    display.println(F("[CANCEL] to ABORT"));
    display.display();

    // Poll cancel button every 50ms while keeping GPS alive
    for (int step = 0; step < 20; step++) {
      while (gpsSerial.available() > 0) gps.encode(gpsSerial.read());
      if (digitalRead(BTN_CANCEL) == LOW) {
        display.clearDisplay();
        display.setCursor(15, 28);
        display.println(F("SOS ALERT ABORTED"));
        display.display();
        delay(1500);
        return false;
      }
      delay(50);
    }
  }
  return true;
}

void triggerAutomaticSOS() {
  String latStr = gps.location.isValid() ? String(gps.location.lat(), 6) : "0.000000";
  String lngStr = gps.location.isValid() ? String(gps.location.lng(), 6) : "0.000000";

  display.clearDisplay();
  display.setCursor(0, 0);
  display.println(F("DISPATCHING SOS..."));
  display.println(F("1. Sending SMS..."));
  display.display();

  // 1. Send Cellular SMS with Google Maps Link
  String smsPayload = "EMERGENCY ALERT! Collision detected on " + NODE_ID +
                      ". Location: https://maps.google.com/?q=" + latStr + "," + lngStr;
  modem.sendSMS(EMERGENCY_PHONE, smsPayload);

  // 2. Initiate Voice Call with 3-Retry Failover
  display.println(F("2. Dialing Contact..."));
  display.display();
  bool callConnected = false;
  for (int attempt = 1; attempt <= 3; attempt++) {
    if (modem.callNumber(EMERGENCY_PHONE)) {
      callConnected = true;
      break;
    }
    delay(2000);
  }

  unsigned long callStartTime = millis();
  unsigned long lastLoRaTx = 0;
  bool alertActive = true;

  // 3. Continuous LoRa V2V Broadcast Loop until Manual Cancel
  while (alertActive) {
    if (millis() - lastLoRaTx > 500) {
      lastLoRaTx = millis();
      broadcastLoRaPacket("AUTO_SOS", latStr, lngStr);

      display.clearDisplay();
      display.setCursor(0, 0);
      display.println(F("SOS BEACON ACTIVE"));
      display.println(F("Broadcasting 433MHz"));
      display.print(F("LAT: ")); display.println(latStr);
      display.print(F("LNG: ")); display.println(lngStr);
      display.setCursor(0, 54);
      display.println(F("[CANCEL] Stop Beacon"));
      display.display();
    }

    // Hang up voice call automatically after 20 seconds
    if (callConnected && (millis() - callStartTime > 20000)) {
      modem.callHangup();
      callConnected = false;
    }

    if (digitalRead(BTN_CANCEL) == LOW) {
      if (callConnected) modem.callHangup();
      alertActive = false;
      impactState = 0;
      delay(500);
    }
  }
}

void executeManualAction(int index) {
  String latStr = gps.location.isValid() ? String(gps.location.lat(), 6) : "0.000000";
  String lngStr = gps.location.isValid() ? String(gps.location.lng(), 6) : "0.000000";

  display.clearDisplay();
  display.setCursor(0, 20);
  display.println(F("Executing Dispatch..."));
  display.display();

  if (index == 0) {
    String msg = "Manual Alert from " + NODE_ID + ": https://maps.google.com/?q=" + latStr + "," + lngStr;
    modem.sendSMS(EMERGENCY_PHONE, msg);
  } else if (index == 1) {
    triggerAutomaticSOS();
  } else if (index == 2) {
    for (int i = 0; i < 5; i++) {
      broadcastLoRaPacket("HAZARD_WARN", latStr, lngStr);
      delay(300);
    }
  }
}

void broadcastLoRaPacket(String alertType, String latStr, String lngStr) {
  String packet = alertType + ":" + NODE_ID + "," + latStr + "," + lngStr;
  LoRa.beginPacket();
  LoRa.print(packet);
  LoRa.endPacket();
  Serial.println("LoRa TX -> " + packet);
}
